@inherits LayoutComponentBase
@implements IDisposable
@inject IActionSubscriber Subscriber
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
<CascadingValue Value="_isDarkMode" Name="IsDarkMode">
    <CascadingValue Value="_toggleThemeCallback" Name="ToggleTheme">
        <MudLayout>
            <MudMainContent>
                @Body
            </MudMainContent>
        </MudLayout>
    </CascadingValue>
</CascadingValue>

@code {
    private const string ThemeStorageKey = "wfe-theme";

    // Источник истины темы. Cascading'ом раздаём в Editor/CanvasTab/MonacoJsEditor.
    private bool _isDarkMode = true;
    private EventCallback _toggleThemeCallback;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#3267ff"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#3267ff",
            Surface = "#1e1e1e",
            Background = "#121212",
            AppbarBackground = "#1a1a1a"
        }
    };

    protected override void OnInitialized()
    {
        _toggleThemeCallback = EventCallback.Factory.Create(this, ToggleTheme);

        Subscriber.SubscribeToAction<ImportFileFailedAction>(this,
            a => Snackbar.Add($"Не удалось загрузить файл «{a.FileName}»: {a.ErrorMessage}", Severity.Error));
        Subscriber.SubscribeToAction<RenameWorkflowFailedAction>(this,
            a => Snackbar.Add($"Не удалось переименовать: {a.ErrorMessage}", Severity.Error));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Восстанавливаем тему из localStorage. Если ключа нет — остаёмся в dark.
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ThemeStorageKey);
            if (saved == "light" && _isDarkMode)
            {
                _isDarkMode = false;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
            // Страница перегружается — игнор.
        }
    }

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ThemeStorageKey, _isDarkMode ? "dark" : "light");
        }
        catch (JSDisconnectedException) { /* игнор */ }
    }

    public void Dispose() => Subscriber.UnsubscribeFromAllActions(this);
}
