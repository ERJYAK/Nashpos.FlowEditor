@inherits LayoutComponentBase
@implements IDisposable
@inject IActionSubscriber Subscriber
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<style>
    /* Рантайм-инъекция стилей с правильным именем класса движка */
    .diagram-port {
        width: 16px !important;
        height: 16px !important;
        background-color: #3267ff !important;
        border: 2px solid #ffffff !important;
        border-radius: 50% !important;
        position: absolute !important;
        z-index: 100 !important;
        display: block !important;
        cursor: crosshair !important;
    }

    .diagram-port:hover {
        background-color: #ff4081 !important;
        transform: scale(1.3) !important;
    }

    /* Позиционирование относительно MudPaper */
    .diagram-port.left { left: -8px !important; top: 50% !important; transform: translateY(-50%) !important; }
    .diagram-port.right { right: -8px !important; top: 50% !important; transform: translateY(-50%) !important; }
    .diagram-port.top { top: -8px !important; left: 50% !important; transform: translateX(-50%) !important; }
    .diagram-port.bottom { bottom: -8px !important; left: 50% !important; transform: translateX(-50%) !important; }

    /* Красная обводка для невалидных узлов после провальной валидации экспорта. */
    .invalid-node { border: 3px solid #ff4444 !important; }
</style>

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
<CascadingValue Value="_isDarkMode" Name="IsDarkMode">
    <CascadingValue Value="_toggleThemeCallback" Name="ToggleTheme">
        <MudLayout>
            <MudMainContent>
                @Body
            </MudMainContent>
        </MudLayout>
    </CascadingValue>
</CascadingValue>

@code {
    private const string ThemeStorageKey = "wfe-theme";

    // Источник истины темы. Cascading'ом раздаём в Editor/CanvasTab/MonacoJsEditor.
    private bool _isDarkMode = true;
    private EventCallback _toggleThemeCallback;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#3267ff"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#3267ff",
            Surface = "#1e1e1e",
            Background = "#121212",
            AppbarBackground = "#1a1a1a"
        }
    };

    protected override void OnInitialized()
    {
        _toggleThemeCallback = EventCallback.Factory.Create(this, ToggleTheme);

        Subscriber.SubscribeToAction<ImportFileFailedAction>(this,
            a => Snackbar.Add($"Не удалось загрузить файл «{a.FileName}»: {a.ErrorMessage}", Severity.Error));
        Subscriber.SubscribeToAction<RenameWorkflowFailedAction>(this,
            a => Snackbar.Add($"Не удалось переименовать: {a.ErrorMessage}", Severity.Error));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Восстанавливаем тему из localStorage. Если ключа нет — остаёмся в dark.
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ThemeStorageKey);
            if (saved == "light" && _isDarkMode)
            {
                _isDarkMode = false;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
            // Страница перегружается — игнор.
        }
    }

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ThemeStorageKey, _isDarkMode ? "dark" : "light");
        }
        catch (JSDisconnectedException) { /* игнор */ }
    }

    public void Dispose() => Subscriber.UnsubscribeFromAllActions(this);
}
